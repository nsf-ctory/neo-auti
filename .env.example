# Credencial server-side. Nunca use prefixo VITE_ para este valor.
GEMINI_API_KEY=preencha_no_ambiente_seguro

# Defina somente quando houver um domínio público real.
AUTI_ALLOWED_ORIGINS=
AUTI_AI_ENABLED=true
AUTI_LIVE_VOICE=Charon

# Limites opcionais por processo.
AUTI_AI_CONCURRENCY=8
AUTI_AI_STARTS_PER_MINUTE=30
AUTI_LIVE_DURATION_MS=300000
AUTI_LIVE_SETUP_TIMEOUT_MS=15000
AUTI_MAX_PAYLOAD_BYTES=262144
AUTI_LIVE_MESSAGES_PER_SECOND=100
